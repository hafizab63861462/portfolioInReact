# Server-only. NO NEXT_PUBLIC_ prefix — that prefix is what would inline a
# value into the browser bundle, and this key must never reach the client.
#
# Free key from https://console.groq.com/keys — starts with "gsk_".
# The shape is validated at runtime, so a key from another provider is
# skipped and reported instead of producing a confusing 401.
GROQ_API_KEY=gsk_REPLACE_ME

# Optional model override. Default is openai/gpt-oss-120b (free).
# openai/gpt-oss-20b is faster but follows the grounding rules less closely.
# CHAT_MODEL=openai/gpt-oss-20b

# Comma-separated origin allowlist. Must contain the exact origin the browser
# sends, or every request gets a 403. Leave unset locally to skip the check.
ALLOWED_ORIGINS=https://hafizportfolio.netlify.app,http://localhost:3000

# Salt for the hashed IP in request logs (raw IPs are never logged).
IP_SALT=replace-with-a-random-string

# Set to "false" to disable the assistant without a redeploy.
CHAT_ENABLED=true
